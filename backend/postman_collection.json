          }
        },
        {
          "name": "Ver Reserva por ID (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservas/1",
              "host": ["{{baseUrl}}"],
              "path": ["reservas", "1"]
            }
          }
        },
        {
          "name": "Ver Reservas de Usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservas/usuario/5",
              "host": ["{{baseUrl}}"],
              "path": ["reservas", "usuario", "5"]
            }
          }
        },
        {
          "name": "Eliminar Reserva (Admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservas/1",
              "host": ["{{baseUrl}}"],
              "path": ["reservas", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Tests",
      "item": [
        {
          "name": "Crear Hospedaje sin Auth",
          "request": {
            "method": "POST",
            "header": [
              {
