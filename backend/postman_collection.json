{
  "info": {
    "name": "Sistema Hotel API",
    "description": "API REST",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Sistema",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    console.log('Login exitoso como admin');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@hotel.com\",\n    \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/login",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "login"]
            }
          }
        },
        {
          "name": "Login Cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"juan@example.com\",\n    \"password\": \"cliente123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/login",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "login"]
            }
          }
        },
        {
          "name": "Registro Usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombre\": \"Usuario Nuevo\",\n    \"email\": \"nuevo@test.com\",\n    \"password\": \"password123\",\n    \"telefono\": \"123-456-789\",\n    \"direccion\": \"Calle Test 123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/register",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "register"]
            }
          }
        },
        {
          "name": "Listar Usuarios (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", ""]
            }
          }
        },
        {
          "name": "Ver Usuario por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/5",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "5"]
            }
          }
        },
        {
          "name": "Eliminar Usuario (Admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/7",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "7"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/logout",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Hospedajes",
      "item": [
        {
          "name": "Listar Hospedajes (Público)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hospedajes/",
              "host": ["{{baseUrl}}"],
              "path": ["hospedajes", ""]
            }
          }
        },
        {
          "name": "Ver Hospedaje por ID (Público)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hospedajes/1",
              "host": ["{{baseUrl}}"],
              "path": ["hospedajes", "1"]
            }
          }
        },
        {
          "name": "Crear Hospedaje (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombre\": \"Suite Presidencial Nueva\",\n    \"descripcion\": \"Amplia suite con vista al mar y jacuzzi\",\n    \"precio\": 400.00,\n    \"capacidad\": 4,\n    \"tipo\": \"suite\",\n    \"foto\": \"suite_nueva.jpg\",\n    \"disponibilidad\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hospedajes/",
              "host": ["{{baseUrl}}"],
              "path": ["hospedajes", ""]
            }
          }
        },
        {
          "name": "Actualizar Hospedaje (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombre\": \"Suite Presidencial Renovada\",\n    \"precio\": 450.00,\n    \"descripcion\": \"Suite completamente renovada con nuevas amenidades\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hospedajes/1",
              "host": ["{{baseUrl}}"],
              "path": ["hospedajes", "1"]
            }
          }
        },
        {
          "name": "Eliminar Hospedaje (Admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hospedajes/1",
              "host": ["{{baseUrl}}"],
              "path": ["hospedajes", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Reservas",
      "item": [
